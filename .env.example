# ============================================================
# ScoreUp — variables d'environnement (.env.example)
# Copier vers .env.local et remplir. Toutes configurables aussi
# dans Vercel > Project > Settings > Environment Variables.
# ============================================================

# ----- 1. SITE -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ScoreUp

# ----- 2. SUPABASE (optionnel au départ — mode démo automatique) -----
# Sans ces clés, l'application fonctionne en mode "démo" (auth fictive,
# données stockées localement). Ajoutez-les pour passer en production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- 3. STRIPE (optionnel au départ — sans clé, checkout renvoie une réponse claire) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants de Price Stripe (Products > Prices)
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY_PRICE_ID=

# ----- 4. AI COACH (optionnel — réponse démo si absent) -----
OPENAI_API_KEY=

# ----- 5. SEO & ANALYTICS (optionnel — tout fonctionne sans) -----
# Google Analytics 4 — mesure anonyme (désactivée si vide)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console — clé de vérification dns/html (si vide, aucun tag)
NEXT_PUBLIC_GSC_VERIFICATION=
# ============================================================
# Prep-Anglais — variables d'environnement (.env.example)
# Copier vers .env.local (développement) ou renseigner dans
# Vercel > Project > Settings > Environment Variables.
# Aucune variable ne doit être commitée dans le dépôt.
# ============================================================

# ----- 1. SITE -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Devise affichée publiquement et appliquée aux tarifs (EUR | USD | GBP)
NEXT_PUBLIC_CURRENCY=EUR

# ----- 2. SUPABASE (requis pour l'authentification réelle) -----
# Sans ces clés, un fallback local discret est utilisé en développement
# (session cookie) — jamais de version "démo" visible dans l'interface.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable du navigateur (ancien nom accepté : NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : SÉRVEUR SEULEMENT (webhook Stripe). Jamais dans le client.
# (ancien nom accepté : SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=

# ----- 3. STRIPE (abonnements réels) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (serveur uniquement, jamais exposés au navigateur) :
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ----- 4. AI (Assistant de préparation) — optionnel -----
OPENAI_API_KEY=

# ----- 5. SEO & ANALYTICS (optionnel — tout fonctionne sans) -----
# Google Analytics 4 — mesure anonyme (désactivée si vide)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console — token de vérification (si vide, aucun tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GSC_VERIFICATION=